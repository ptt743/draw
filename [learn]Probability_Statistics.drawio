        </mxCell>
        <mxCell id="QOYDL-N6hfAYlKEw_OqY-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="Mode là giá trị xuất hiện nhiều nhất. Một tập dữ liệu có thể là unimodal (1 mode), bimodal (2 mode) hoặc không có mode" vertex="1">
          <mxGeometry height="39" width="175" x="1040" y="-49" as="geometry" />
        </mxCell>
        <mxCell id="QOYDL-N6hfAYlKEw_OqY-6" edge="1" parent="1" style="endArrow=none;html=1;rounded=1;strokeWidth=0.65;endFill=0;strokeColor=#808080;fontFamily=Times New Roman;entryX=0;entryY=0;entryDx=0;entryDy=0;curved=0;" target="QOYDL-N6hfAYlKEw_OqY-7" value="">
