        <mxCell id="QOYDL-N6hfAYlKEw_OqY-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Times New Roman;fontSize=8;" value="&lt;span style=&quot;background-color: rgb(230, 255, 204);&quot;&gt;Symmetrical (đối xứng)&lt;/span&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;mean ≈ median ≈ mode" vertex="1">
          <mxGeometry height="15" width="160" x="1010" y="-150" as="geometry" />
        </mxCell>
        <mxCell id="QOYDL-N6hfAYlKEw_OqY-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Times New Roman;fontSize=8;" value="&lt;span style=&quot;background-color: rgb(255, 230, 204);&quot;&gt;Skewed right / positive skew (đuôi kéo về phải)&lt;/span&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;mode &amp;lt; median &amp;lt; mean" vertex="1">
          <mxGeometry height="15" width="240" x="1010" y="-125" as="geometry" />
        </mxCell>
        <mxCell id="QOYDL-N6hfAYlKEw_OqY-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Times New Roman;fontSize=8;" value="&lt;span style=&quot;background-color: rgb(255, 204, 204);&quot;&gt;Skewed left / negative skew (đuôi kéo về trái)&lt;/span&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;mean &amp;lt; median &amp;lt; mode" vertex="1">
          <mxGeometry height="15" width="240" x="1010" y="-100" as="geometry" />
        </mxCell>
        <mxCell id="QOYDL-N6hfAYlKEw_OqY-10" edge="1" parent="1" source="tKNkKJuM1-rNgPKOT61r-15" style="endArrow=none;html=1;rounded=1;strokeWidth=0.65;endFill=0;strokeColor=#808080;exitX=0.5;exitY=0;exitDx=0;exitDy=0;curved=0;" value="">
