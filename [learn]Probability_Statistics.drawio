        <mxCell id="QOYDL-N6hfAYlKEw_OqY-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;Variance là trung bình của bình phương độ lệch so với mean.&lt;/div&gt;&lt;div&gt;• Population: \(\sigma^2 = \sum(x - \mu)^2 / N\)&lt;/div&gt;&lt;div&gt;• Sample: \(s^2 = \sum(x - \bar{x})^2 / (n - 1)\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="39" width="230" x="1160" y="100" as="geometry" />
        </mxCell>
