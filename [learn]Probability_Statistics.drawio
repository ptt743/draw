        <mxCell id="tKNkKJuM1-rNgPKOT61r-36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• Sample mean: \(\bar{x} = \frac{\sum x}{n}\)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;• Population mean: \(\mu = \frac{\sum x}{N}\)&lt;/div&gt;" vertex="1">
