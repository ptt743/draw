        <mxCell id="tKNkKJuM1-rNgPKOT61r-35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="Sắp xếp dữ liệu, rồi lấy giá trị nằm giữa. Nếu n chẵn thì lấy trung bình của 2 giá trị ở giữa" vertex="1">
