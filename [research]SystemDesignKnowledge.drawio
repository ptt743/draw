          <mxGeometry height="20" width="90" x="-758.5" y="3160" as="geometry" />
        </mxCell>
        <mxCell id="vlTXolutErGigSJS3izG-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;" value="Geographic Sharding" vertex="1">
          <mxGeometry height="20" width="90" x="-758.5" y="3260" as="geometry" />
        </mxCell>
        <mxCell id="vlTXolutErGigSJS3izG-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;using mapping table to&amp;nbsp;determine which shard the data belongs to&lt;/div&gt;&lt;span style=&quot;background-color: rgb(204, 255, 204);&quot;&gt;pro&lt;/span&gt;: flexibility, easily relocate data without changing the distribution formula&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 204, 204);&quot;&gt;cons&lt;/span&gt; :&amp;nbsp;Requires maintaining the Shard Map, managing the cache, and ensuring mapping accuracy&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="358" x="-1080" y="3021" as="geometry" />
        </mxCell>
        <mxCell id="vlTXolutErGigSJS3izG-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;align=left;verticalAlign=top;" value="Partition data based on contiguous ranges of values.&lt;br&gt;&lt;span style=&quot;background-color: rgb(204, 255, 204);&quot;&gt;pro&lt;/span&gt;: efficient for range queries and easy to manage over time.&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 204, 204);&quot;&gt;cons&lt;/span&gt; :&amp;nbsp;Prone to hotspots if most requests are routed to a single shard, causing it to handle the majority of the write traffic.&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="286.5" x="-1000" y="3100" as="geometry" />
        </mxCell>
        <mxCell id="vlTXolutErGigSJS3izG-19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;Use a hash function to distribute data:&lt;/div&gt;&lt;span style=&quot;background-color: rgb(204, 255, 204);&quot;&gt;pro&lt;/span&gt;:&amp;nbsp;Distributes data relatively evenly, reducing the risk of hotspots caused by sequential IDs.&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 204, 204);&quot;&gt;cons&lt;/span&gt; :&lt;br&gt;&lt;div&gt;- Range queries often require accessing multiple shards.&lt;/div&gt;&lt;div&gt;- Adding or removing shards requires migrating a large amount of data.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="366.5" x="-1080" y="3190" as="geometry" />
        </mxCell>
        <mxCell id="vlTXolutErGigSJS3izG-20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;Partition data based on geographic location.&lt;/div&gt;&lt;span style=&quot;background-color: rgb(204, 255, 204);&quot;&gt;pro&lt;/span&gt;:&amp;nbsp;Reduces network latency for regional access and supports regional data residency requirements&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 204, 204);&quot;&gt;cons&lt;/span&gt; :&amp;nbsp;Traffic may be unevenly distributed across regions; global aggregation queries incur higher costs and latency&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="436.5" x="-1150" y="3290" as="geometry" />
        </mxCell>
