        <mxCell id="vlTXolutErGigSJS3izG-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;" value="Cross-shard Transaction" vertex="1">
