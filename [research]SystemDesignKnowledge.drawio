        <mxCell id="vlTXolutErGigSJS3izG-38" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Comic Sans MS;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;If the data is distributed across three shards, the application needs to:&lt;/div&gt;&lt;div&gt;1. Query the total revenue from each shard.&lt;/div&gt;&lt;div&gt;2. Collect the results.&lt;/div&gt;&lt;div&gt;3. Sum the results.&lt;/div&gt;&lt;div&gt;This is called a Fan-out Query. Queries can be executed in parallel, but processing costs and latency are generally higher than those of a single-shard query, especially when cross-shard JOINs or global sorting are required&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="340" x="-1600" y="3069.75" as="geometry" />
        </mxCell>
