        <mxCell id="tBM32NNUEKplR6O0RedK-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Comic Sans MS;fontSize=10;" value="&lt;span style=&quot;background-color: rgb(255, 230, 204);&quot;&gt;DP Lexicographic Order&lt;/span&gt;" vertex="1">
          <mxGeometry height="14" width="117" x="1550" y="2380" as="geometry" />
        </mxCell>
        <mxCell id="tBM32NNUEKplR6O0RedK-2" edge="1" parent="1" source="gejDCW2IM3L-HhZqzkMl-1" style="endArrow=openThin;html=1;rounded=0;strokeWidth=0.65;endFill=0;strokeColor=#001DBC;fontFamily=Comic Sans MS;fillColor=#0050ef;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="tBM32NNUEKplR6O0RedK-1" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="900" y="2226" as="sourcePoint" />
            <mxPoint x="1070" y="2313" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tBM32NNUEKplR6O0RedK-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeWidth=0.5;strokeColor=#808080;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;void recurse(int len, long long K, string&amp;amp; answer, const vector&amp;lt;vector&amp;lt;long long&amp;gt;&amp;gt;&amp;amp; d, int last_char_index) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (len == 0) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int m = 3;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; for (int j = 0; j &amp;lt; m; ++j) {&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; bool isValid = true;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (last_char_index != -1) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (last_char_index == 0 &amp;amp;&amp;amp; j == 1) isValid = false; // Cấm &#39;a&#39; rồi &#39;b&#39; (ab)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (last_char_index == 1 &amp;amp;&amp;amp; j == 1) isValid = false; // Cấm &#39;b&#39; rồi &#39;b&#39; (bb)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (last_char_index == 2 &amp;amp;&amp;amp; j == 0) isValid = false; // Cấm &#39;c&#39; rồi &#39;a&#39; (ca)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (isValid) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (K &amp;gt; d[len][j]) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; K -= d[len][j]; // Bỏ qua tất cả các chuỗi bắt đầu bằng ký tự j&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; } else {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; answer += (char)(&#39;a&#39; + j);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; recurse(len - 1, K, answer, d, j);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="283" width="455" x="1550" y="2398" as="geometry" />
        </mxCell>
        <mxCell id="tBM32NNUEKplR6O0RedK-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeWidth=0.5;strokeColor=#808080;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;&amp;nbsp; &amp;nbsp; int n = 5; // Độ dài chuỗi (ví dụ)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; long long K = 10; // Cần tìm chuỗi thứ 10&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;vector&amp;lt;long long&amp;gt;&amp;gt; d(n + 1, vector&amp;lt;long long&amp;gt;(3, 0));&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; d[1][0] = d[1][1] = d[1][2] = 1;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; for (int i = 2; i &amp;lt;= n; ++i) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // Nếu chuỗi dài i bắt đầu bằng &#39;a&#39;, ký tự tiếp theo (ở chuỗi dài i-1) không được là &#39;b&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; d[i][0] = d[i - 1][0] + d[i - 1][2];&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // Nếu chuỗi dài i bắt đầu bằng &#39;b&#39;, ký tự tiếp theo không được là &#39;b&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; d[i][1] = d[i - 1][0] + d[i - 1][2];&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // Nếu chuỗi dài i bắt đầu bằng &#39;c&#39;, ký tự tiếp theo không được là &#39;a&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; d[i][2] = d[i - 1][1] + d[i - 1][2];&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; string answer = &quot;&quot;;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; recurse(n, K, answer, d, -1);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; &quot;Chuoi thu &quot; &amp;lt;&amp;lt; K &amp;lt;&amp;lt; &quot; co do dai &quot; &amp;lt;&amp;lt; n &amp;lt;&amp;lt; &quot; la: &quot; &amp;lt;&amp;lt; answer &amp;lt;&amp;lt; endl;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return 0;&lt;/div&gt;" vertex="1">
          <mxGeometry height="216" width="385" x="2005" y="2398" as="geometry" />
        </mxCell>
