        <mxCell id="ryQgb2nl-CPhoF6lq91R-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeWidth=0.5;fontSize=10;strokeColor=#808080;" value="Phát hiện chu trình bằng DSU, hoặc bằng DFS có bỏ qua đỉnh cha" vertex="1">
          <mxGeometry height="20" width="300" x="3185" y="911" as="geometry" />
