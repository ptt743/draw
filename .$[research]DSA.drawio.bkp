        <mxCell id="4MqsonkfkXiYIx7OfNp9-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;struct node {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int pre, suf, sum, maxsum;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; static node base() { return { -inf, -inf, 0, -inf }; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; static node merge(const node&amp;amp; a, const node&amp;amp; b)&amp;nbsp; {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; node res;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; res.pre = max(a.pre, b.pre + a.sum);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; res.suf = max(b.suf, a.suf + b.sum);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; res.sum = a.sum + b.sum;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; res.maxsum = max(a.maxsum, b.maxsum);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; res.maxsum = max(res.maxsum, a.suf + b.pre);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return res;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;};&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;int n, m;&lt;/div&gt;&lt;div&gt;int a[maxN];&lt;/div&gt;&lt;div&gt;node st[4 * maxN];&lt;/div&gt;" vertex="1">
          <mxGeometry height="232" width="262" x="-2105" y="3242" as="geometry" />
        </mxCell>
        <mxCell id="4MqsonkfkXiYIx7OfNp9-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;void build(int id, int l ,int r) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (l == r) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; st[id] = { a[l], a[l], a[l], a[l] };&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int mid = l + r &amp;gt;&amp;gt; 1;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; build(2 * id, l, mid);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; build(2 * id + 1, mid + 1, r);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; st[id] = node::merge(st[2 * id], st[2 * id + 1]);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;node get(int id, int l, int r, int u, int v){&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (l &amp;gt;&amp;nbsp; v || r &amp;lt;&amp;nbsp; u) return node::base();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (l &amp;gt;= u &amp;amp;&amp;amp; r &amp;lt;= v) return st[id];&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int mid = l + r &amp;gt;&amp;gt; 1;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; node g1 = get(2 * id, l, mid, u, v);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; node g2 = get(2 * id + 1, mid + 1, r, u, v);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return node::merge(g1, g2);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;int main() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cin &amp;gt;&amp;gt; n;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; for (int i = 1; i &amp;lt;= n; ++i) cin &amp;gt;&amp;gt; a[i];&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; build(1, 1, n);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cin &amp;gt;&amp;gt; m;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; while (m--) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; int x, y;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cin &amp;gt;&amp;gt; x &amp;gt;&amp;gt; y;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; get(1, 1, n, x, y).maxsum &amp;lt;&amp;lt; &#39;\n&#39;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="382" width="228" x="-1843" y="3242" as="geometry" />
        </mxCell>
        <mxCell id="4MqsonkfkXiYIx7OfNp9-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;const int INF = -1e9 - 7;&lt;/div&gt;&lt;div&gt;vector&amp;lt;int&amp;gt; a;&lt;/div&gt;&lt;div&gt;vector&amp;lt;long long&amp;gt; st;&lt;/div&gt;&lt;div&gt;vector&amp;lt;long long&amp;gt; lazy;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;void push_down(int id, int l, int r) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (lazy[id] == 0) return;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; lazy[2 * id] += lazy[id];&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; lazy[2 * id + 1] += lazy[id];&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; st[2 * id] += lazy[id];&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; st[2 * id + 1] += lazy[id];&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; lazy[id] = 0;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="177" width="169" x="-2110" y="2944" as="geometry" />
        </mxCell>
        <mxCell id="4MqsonkfkXiYIx7OfNp9-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=10;" value="&lt;font face=&quot;Comic Sans MS&quot; style=&quot;background-color: rgb(204, 204, 255);&quot;&gt;lazy approach&lt;/font&gt;" vertex="1">
          <mxGeometry height="15" width="66" x="-2111" y="2943" as="geometry" />
        </mxCell>
        <mxCell id="4MqsonkfkXiYIx7OfNp9-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;void update_range(int id, int l, int r, int u, int v, int val) {&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; if (v &amp;lt; l || u &amp;gt; r) return;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; if (u &amp;lt;= l &amp;amp;&amp;amp; r &amp;lt;= v) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; st[id] += val;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; lazy[id] += val;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; push_down(id, l, r);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int mid = l + (r - l) / 2;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; update_range(2 * id, l, mid, u, v, val);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; update_range(2 * id + 1, mid + 1, r, u, v, val);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; st[id] = max(st[2 * id], st[2 * id + 1]);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;long long get_max(int id, int l, int r, int u, int v) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (v &amp;lt; l || u &amp;gt; r) return INF;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (u &amp;lt;= l &amp;amp;&amp;amp; r &amp;lt;= v) return st[id];&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; push_down(id, l, r);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int mid = l + (r - l) / 2;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; long long max_left = get_max(2 * id, l, mid, u, v);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; long long max_right = get_max(2 * id + 1, mid + 1, r, u, v);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return max(max_left, max_right);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="286" width="290" x="-1941" y="2944" as="geometry" />
        </mxCell>
        <mxCell id="4MqsonkfkXiYIx7OfNp9-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;int main() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int n = 5;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; a = {0, 1, 2, 3, 4, 5};&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; st.assign(4 * (n + 1), 0);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; lazy.assign(4 * (n + 1), 0);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="81" width="133" x="-1651" y="2944" as="geometry" />
        </mxCell>
