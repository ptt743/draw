        <mxCell id="Tl8x3K-try52lmQbKxnG-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;struct DSU {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;int&amp;gt; parent, sz;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; DSU(int n) : parent(n), sz(n, 1) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; iota(parent.begin(), parent.end(), 0);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int find(int x) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return parent[x] == x ? x : parent[x] = find(parent[x]);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bool unite(int a, int b) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; a = find(a); b = find(b);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (a == b) return false;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (sz[a] &amp;lt; sz[b]) swap(a, b);&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; parent[b] = a;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; sz[a] += sz[b];&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return true;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;};&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;struct Edge {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int u, v;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; long long w;&lt;/div&gt;&lt;div&gt;};&lt;/div&gt;" vertex="1">
          <mxGeometry height="282" width="254.5" x="2565.5" y="49" as="geometry" />
        </mxCell>
        <mxCell id="Tl8x3K-try52lmQbKxnG-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;int main() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int n, m;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cin &amp;gt;&amp;gt; n &amp;gt;&amp;gt; m;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;Edge&amp;gt; edges(m);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; for (auto&amp;amp; e : edges) cin &amp;gt;&amp;gt; e.u &amp;gt;&amp;gt; e.v &amp;gt;&amp;gt; e.w;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; sort(edges.begin(), edges.end());&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; DSU dsu(n);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; long long total = 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;Edge&amp;gt; mst;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; for (auto&amp;amp; e : edges) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (dsu.unite(e.u, e.v)) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; total += e.w;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; mst.push_back(e);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if ((int)mst.size() == n - 1) break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if ((int)mst.size() != n - 1) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; &quot;Do thi khong lien thong\n&quot;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; &quot;Tong trong so MST: &quot; &amp;lt;&amp;lt; total &amp;lt;&amp;lt; &quot;\n&quot;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; for (auto&amp;amp; e : mst) cout &amp;lt;&amp;lt; e.u &amp;lt;&amp;lt; &quot; - &quot; &amp;lt;&amp;lt; e.v &amp;lt;&amp;lt; &quot; : &quot; &amp;lt;&amp;lt; e.w &amp;lt;&amp;lt; &quot;\n&quot;;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="282" width="300" x="2265.5" y="49" as="geometry" />
        </mxCell>
        <mxCell id="Tl8x3K-try52lmQbKxnG-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="&lt;div&gt;typedef pair&amp;lt;long long, int&amp;gt; pli; // (trọng số, đỉnh)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;int main() {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int n, m;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;vector&amp;lt;pair&amp;lt;int, long long&amp;gt;&amp;gt;&amp;gt; adj(n);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;bool&amp;gt; inTree(n, false);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;int&amp;gt; parent(n, -1);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; vector&amp;lt;long long&amp;gt; key(n, LLONG_MAX);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; priority_queue&amp;lt;pli, vector&amp;lt;pli&amp;gt;, greater&amp;lt;pli&amp;gt;&amp;gt; pq;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; key[0] = 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; pq.push({0, 0});&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; long long total = 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; int cnt = 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; while (!pq.empty()) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; auto [w, u] = pq.top(); pq.pop();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (inTree[u]) continue;&amp;nbsp; &amp;nbsp; // bỏ qua bản ghi cũ&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; inTree[u] = true;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; total += w;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cnt++;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; for (auto [v, wt] : adj[u]) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!inTree[v] &amp;amp;&amp;amp; wt &amp;lt; key[v]) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; key[v] = wt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; parent[v] = u;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; pq.push({wt, v});&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (cnt != n) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; &quot;Do thi khong lien thong\n&quot;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; &quot;Tong trong so MST: &quot; &amp;lt;&amp;lt; total &amp;lt;&amp;lt; &quot;\n&quot;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; for (int v = 1; v &amp;lt; n; v++)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cout &amp;lt;&amp;lt; parent[v] &amp;lt;&amp;lt; &quot; - &quot; &amp;lt;&amp;lt; v &amp;lt;&amp;lt; &quot; : &quot; &amp;lt;&amp;lt; key[v] &amp;lt;&amp;lt; &quot;\n&quot;;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="449" width="280" x="2840" y="50" as="geometry" />
        </mxCell>
        <mxCell id="Tl8x3K-try52lmQbKxnG-16" edge="1" parent="1" source="ryQgb2nl-CPhoF6lq91R-42" style="endArrow=none;html=1;rounded=1;endFill=0;strokeColor=#001DBC;strokeWidth=0.65;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=0;fillColor=#0050ef;" target="Tl8x3K-try52lmQbKxnG-4" value="">
