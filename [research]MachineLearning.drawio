        <mxCell id="iM6ubH6x_SA4rBZXDKRm-387" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# 2. Create degree-2 polynomial features: [x, x^2]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# include_bias=False because LinearRegression already fits the intercept&lt;/span&gt;&lt;/div&gt;&lt;div&gt;poly = PolynomialFeatures(degree=2, include_bias=False)&lt;/div&gt;&lt;div&gt;poly_features = poly.fit_transform(x.reshape(-1, 1))&lt;/div&gt;&lt;/div&gt;" vertex="1">
