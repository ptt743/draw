        <mxCell id="2h8pMpTKfX5dz2XeYOvV-3" edge="1" parent="1" source="2h8pMpTKfX5dz2XeYOvV-2" style="endArrow=none;html=1;rounded=1;strokeWidth=0.65;endFill=0;strokeColor=#808080;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;curved=0;" target="iM6ubH6x_SA4rBZXDKRm-358" value="">
          <mxGeometry height="50" relative="1" width="50" x="-0.1458" as="geometry">
            <Array as="points">
              <mxPoint x="-1690" y="1348" />
              <mxPoint x="-1690" y="1210" />
              <mxPoint x="-1770" y="1210" />
            </Array>
            <mxPoint x="-2050" y="1230" as="sourcePoint" />
            <mxPoint x="-2020" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;from sklearn.model_selection import train_test_split&lt;/div&gt;&lt;div&gt;from sklearn.metrics import mean_squared_error&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# 1. Dữ liệu mô phỏng: y phụ thuộc bậc 2 vào x_1; x_2 chỉ là nhiễu&lt;/span&gt;&lt;/div&gt;&lt;div&gt;np.random.seed(1)&lt;/div&gt;&lt;div&gt;x_1 = np.absolute(np.random.randn(100, 1) * 10)&lt;/div&gt;&lt;div&gt;x_2 = np.absolute(np.random.randn(100, 1) * 30)&lt;/div&gt;&lt;div&gt;y = 2 * x_1**2 + 3 * x_1 + 2 + np.random.randn(100, 1) * 20&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;fig, axes = plt.subplots(nrows=1, ncols=2, figsize=(10, 4))&lt;/div&gt;&lt;div&gt;axes[0].scatter(x_1, y)&lt;/div&gt;&lt;div&gt;axes[1].scatter(x_2, y)&lt;/div&gt;&lt;div&gt;axes[0].set_title(&quot;x_1 plotted&quot;)&lt;/div&gt;&lt;div&gt;axes[1].set_title(&quot;x_2 plotted&quot;)&lt;/div&gt;&lt;div&gt;plt.show()&lt;/div&gt;" vertex="1">
          <mxGeometry height="159" width="222.5" x="-2000.5" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-5" edge="1" parent="1" source="2h8pMpTKfX5dz2XeYOvV-4" style="endArrow=none;html=1;rounded=1;strokeWidth=0.65;endFill=0;strokeColor=#808080;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;curved=0;" target="2h8pMpTKfX5dz2XeYOvV-2" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="-1736.62" y="1440" />
            </Array>
            <mxPoint x="-1720" y="1350" as="sourcePoint" />
            <mxPoint x="-1690" y="1320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# 2. Gom vào DataFrame&lt;/span&gt;&lt;/div&gt;&lt;div&gt;df = pd.DataFrame({&quot;x_1&quot;: x_1.reshape(100,),&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&quot;x_2&quot;: x_2.reshape(100,),&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&quot;y&quot;:&amp;nbsp; &amp;nbsp;y.reshape(100,)})&lt;/div&gt;&lt;div&gt;X, y = df[[&quot;x_1&quot;, &quot;x_2&quot;]], df[&quot;y&quot;]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# 3. Đặc trưng đa thức: x_1, x_2, x_1^2, x_1*x_2, x_2^2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;poly = PolynomialFeatures(degree=2, include_bias=False)&lt;/div&gt;&lt;div&gt;poly_features = poly.fit_transform(X)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;X_train, X_test, y_train, y_test = train_test_split(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; poly_features, y, test_size=0.3, random_state=42)&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="-2280" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-8" edge="1" parent="1" source="2h8pMpTKfX5dz2XeYOvV-4" style="endArrow=none;html=1;rounded=1;strokeWidth=0.65;endFill=0;strokeColor=#808080;exitX=-0.001;exitY=0.939;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;curved=0;" target="2h8pMpTKfX5dz2XeYOvV-7" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="-2100" y="1550" />
            </Array>
            <mxPoint x="-2010" y="1420" as="sourcePoint" />
            <mxPoint x="-1980" y="1390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# 4. Mô hình đa thức + RMSE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;poly_reg_model = LinearRegression()&lt;/div&gt;&lt;div&gt;poly_reg_model.fit(X_train, y_train)&lt;/div&gt;&lt;div&gt;poly_rmse = np.sqrt(mean_squared_error(y_test, poly_reg_model.predict(X_test)))&lt;/div&gt;&lt;div&gt;print(&quot;Polynomial RMSE:&quot;, poly_rmse)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;# 5. Mô hình tuyến tính (dùng X gốc) để so sánh&lt;/span&gt;&lt;/div&gt;&lt;div&gt;X_train, X_test, y_train, y_test = train_test_split(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; X, y, test_size=0.3, random_state=42)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;lin_reg_model = LinearRegression()&lt;/div&gt;&lt;div&gt;lin_reg_model.fit(X_train, y_train)&lt;/div&gt;&lt;div&gt;lin_rmse = np.sqrt(mean_squared_error(y_test, lin_reg_model.predict(X_test)))&lt;/div&gt;&lt;div&gt;print(&quot;Linear RMSE:&quot;, lin_rmse)&lt;/div&gt;" vertex="1">
          <mxGeometry height="144.5" width="269.5" x="-2589" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-10" edge="1" parent="1" source="2h8pMpTKfX5dz2XeYOvV-9" style="endArrow=none;html=1;rounded=1;strokeWidth=0.65;endFill=0;strokeColor=#808080;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.307;entryDx=0;entryDy=0;entryPerimeter=0;curved=0;" target="2h8pMpTKfX5dz2XeYOvV-7" value="">
          <mxGeometry height="50" relative="1" width="50" x="0.0141" as="geometry">
            <Array as="points">
              <mxPoint x="-2300" y="1522.25" />
              <mxPoint x="-2300" y="1440" />
            </Array>
            <mxPoint x="-2290" y="1420" as="sourcePoint" />
            <mxPoint x="-2260" y="1390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2h8pMpTKfX5dz2XeYOvV-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;# 6. Xem hệ số&lt;/div&gt;&lt;div&gt;print(lin_reg_model.coef_, lin_reg_model.intercept_)&lt;/div&gt;&lt;div&gt;print(poly_reg_model.coef_, poly_reg_model.intercept_)&lt;/div&gt;" vertex="1">
