        <mxCell id="2h8pMpTKfX5dz2XeYOvV-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=8;fillColor=#dae8fc;align=left;" value="Multivariable polynomial regression" vertex="1">
