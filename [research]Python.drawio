        <mxCell id="w7hy6oTUh5BCP_kFYmaT-72" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Comic Sans MS;strokeWidth=0.5;fontSize=10;strokeColor=#808080;" value="&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;# Cách viết hàm thông thường&lt;/div&gt;&lt;div style=&quot;&quot;&gt;def add_normal(x, y):&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; return x + y&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;# Cách viết bằng Lambda&lt;/div&gt;&lt;div style=&quot;&quot;&gt;add_lambda = lambda x, y: x + y&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;print(add_lambda(5, 7)) # Output: 12&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;# Ứng dụng thực tế: Lọc các số chẵn trong danh sách&lt;/div&gt;&lt;div style=&quot;&quot;&gt;numbers = [1, 2, 3, 4, 5, 6]&lt;/div&gt;&lt;div style=&quot;&quot;&gt;evens = list(filter(lambda x: x % 2 == 0, numbers))&lt;/div&gt;&lt;div style=&quot;&quot;&gt;print(evens) # Output: [2, 4, 6]&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
