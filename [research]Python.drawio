        <mxCell id="w7hy6oTUh5BCP_kFYmaT-78" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Comic Sans MS;strokeWidth=0.5;fontSize=10;strokeColor=#808080;" value="&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;my_list = [&quot;Táo&quot;, &quot;Chuối&quot;, &quot;Cam&quot;]&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;# Biến danh sách thành một bộ lặp (Iterator)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;my_iterator = iter(my_list)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;# Lấy từng giá trị ra bằng hàm next()&lt;/div&gt;&lt;div style=&quot;&quot;&gt;print(next(my_iterator)) # Output: Táo&lt;/div&gt;&lt;div style=&quot;&quot;&gt;print(next(my_iterator)) # Output: Chuối&lt;/div&gt;&lt;div style=&quot;&quot;&gt;print(next(my_iterator)) # Output: Cam&lt;/div&gt;&lt;div style=&quot;&quot;&gt;# Nếu gọi next() nữa sẽ báo lỗi StopIteration vì đã hết phần tử&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
