        <mxCell id="w7hy6oTUh5BCP_kFYmaT-56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Comic Sans MS;strokeWidth=0.5;fontSize=10;" value="&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;class TreeNode:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; def __init__(self, value):&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; self.value = value&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; self.left = None&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; self.right = None&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;# Xây dựng một cây nhỏ&lt;/div&gt;&lt;div style=&quot;&quot;&gt;root = TreeNode(10)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;root.left = TreeNode(5)&amp;nbsp; &amp;nbsp;# 5 &amp;lt; 10 (Nằm bên trái)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;root.right = TreeNode(15) # 15 &amp;gt; 10 (Nằm bên phải)&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
