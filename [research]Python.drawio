        <mxCell id="w7hy6oTUh5BCP_kFYmaT-75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Comic Sans MS;strokeWidth=0.5;fontSize=10;strokeColor=#808080;" value="# Tạo một decorator để in ra thông báo trước và sau khi chạy hàm&lt;br&gt;def my_decorator(func):&lt;br&gt;&amp;nbsp; &amp;nbsp; def wrapper():&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; print(&quot;Đang chuẩn bị chạy hàm...&quot;)&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; func() # Chạy hàm gốc&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; print(&quot;Đã chạy hàm xong!&quot;)&lt;br&gt;&amp;nbsp; &amp;nbsp; return wrapper&lt;br&gt;&lt;br&gt;# Áp dụng decorator vào một hàm bất kỳ&lt;br&gt;@my_decorator&lt;br&gt;def say_hello():&lt;br&gt;&amp;nbsp; &amp;nbsp; print(&quot;Xin chào các bạn!&quot;)&lt;br&gt;&lt;br&gt;say_hello()&lt;br&gt;# Output:&lt;br&gt;# Đang chuẩn bị chạy hàm...&lt;br&gt;# Xin chào các bạn!&lt;br&gt;# Đã chạy hàm xong!" vertex="1">
