        <mxCell id="w7hy6oTUh5BCP_kFYmaT-53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Comic Sans MS;strokeWidth=0.5;fontSize=10;" value="&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;# stack (Dùng List)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;stack = []&lt;/div&gt;&lt;div style=&quot;&quot;&gt;stack.append(1) # Đưa vào ngăn xếp&lt;/div&gt;&lt;div style=&quot;&quot;&gt;stack.append(2)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;print(stack.pop())&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;// queue&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span class=&quot;hljs-keyword&quot;&gt;from&lt;/span&gt; collections &lt;span class=&quot;hljs-keyword&quot;&gt;import&lt;/span&gt; deque&lt;br&gt;queue = deque([&lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;2&lt;/span&gt;])&lt;br&gt;queue.append(&lt;span class=&quot;hljs-number&quot;&gt;3&lt;/span&gt;)    &lt;span class=&quot;hljs-comment&quot;&gt;# Xếp hàng&lt;/span&gt;&lt;br&gt;print(queue.popleft())&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;// minheap&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;# heap (Min-Heap trong Python)&lt;/div&gt;&lt;div&gt;import heapq&lt;/div&gt;&lt;div&gt;heap = [5, 1, 8]&lt;/div&gt;&lt;div&gt;heapq.heapify(heap)&lt;/div&gt;&lt;div&gt;print(heapq.heappop(heap))&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="249.5" width="230" x="1730" y="1110" as="geometry" />
