        <mxCell id="c8WGveU2vl_N7zniUJf_-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;CREATE TABLE ledger_accounts (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;account_id&lt;/b&gt; BIGINT PRIMARY KEY AUTO_INCREMENT,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;account_code&lt;/b&gt; VARCHAR(80) NOT NULL UNIQUE,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;account_type&lt;/b&gt; ENUM(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;USER_WALLET&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;BANK_CLEARING&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;MERCHANT_PAYABLE&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;FEE_REVENUE&lt;/span&gt;&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;user_id&lt;/b&gt; BIGINT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;merchant_id&lt;/b&gt; BIGINT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;currency&lt;/b&gt; CHAR(3) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;balance&lt;/b&gt; DECIMAL(20,4) NOT NULL DEFAULT 0,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;version&lt;/b&gt; BIGINT NOT NULL DEFAULT 0,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;status&lt;/b&gt; ENUM(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(153, 0, 0);&quot;&gt;ACTIVE&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(153, 0, 0);&quot;&gt;FROZEN&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(153, 0, 0);&quot;&gt;CLOSED&lt;/span&gt;&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ) NOT NULL DEFAULT &#39;ACTIVE&#39;,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;created_at&lt;/b&gt; DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;updated_at&lt;/b&gt; DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ON UPDATE CURRENT_TIMESTAMP(6),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UNIQUE KEY &lt;span style=&quot;color: rgb(204, 102, 0);&quot;&gt;uq_user_wallet&lt;/span&gt; (user_id, currency),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UNIQUE KEY &lt;span style=&quot;color: rgb(204, 102, 0);&quot;&gt;uq_merchant_account&lt;/span&gt; (merchant_id, currency),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UNIQUE KEY &lt;span style=&quot;color: rgb(204, 102, 0);&quot;&gt;uq_account_currency&lt;/span&gt; (account_id, currency),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CHECK (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; account_type &amp;lt;&amp;gt; &#39;USER_WALLET&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OR balance &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; )&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;" vertex="1">
