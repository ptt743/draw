        <mxCell id="c8WGveU2vl_N7zniUJf_-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=0.5;strokeColor=#808080;fontFamily=Times New Roman;fontSize=8;align=left;verticalAlign=top;" value="&lt;div&gt;CREATE TABLE &lt;b&gt;financial_transactions&lt;/b&gt; (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;transaction_id&lt;/b&gt; BIGINT PRIMARY KEY AUTO_INCREMENT,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;reference_id&lt;/b&gt; CHAR(36) NOT NULL UNIQUE,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;requester_user_id&lt;/b&gt; BIGINT NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;idempotency_key&lt;/b&gt; VARCHAR(128) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;transaction_type&lt;/b&gt; ENUM(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;TOP_UP&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;TRANSFER&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;PAYMENT&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;REFUND&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;REVERSAL&lt;/span&gt;&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;status&lt;/b&gt; ENUM(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;PENDING&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;POSTED&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;FAILED&lt;/span&gt;&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;REVERSED&lt;/span&gt;&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ) NOT NULL DEFAULT &#39;PENDING&#39;,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;amount&lt;/b&gt; DECIMAL(20,4) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;currency&lt;/b&gt; CHAR(3) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;description&lt;/b&gt; VARCHAR(200),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;created_at&lt;/b&gt; DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;posted_at&lt;/b&gt; DATETIME(6) NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UNIQUE KEY &lt;b&gt;uq_idempotency&lt;/b&gt; (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; requester_user_id,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; idempotency_key&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UNIQUE KEY &lt;b&gt;uq_transaction_currency&lt;/b&gt; (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; transaction_id,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; currency&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FOREIGN KEY (requester_user_id)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; REFERENCES users(id),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CHECK (amount &amp;gt; 0)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;" vertex="1">
