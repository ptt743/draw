<mxfile host="Electron" version="29.3.0"><diagram name="1. Flow Get ID (centralizeid)" id="getid"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Flow Get ID – &lt;font color='#6c8ebf'&gt;centralizeid&lt;/font&gt; · &lt;code&gt;POST /id/mobile/{ios|android|wphone}&lt;/code&gt; (DeviceIdHandler)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="src" value="&lt;i&gt;Nguồn: origin/production (centralizeid 94d2434) + docs/centralizeid/01, 02&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="800" height="20" as="geometry"/></mxCell><mxCell id="sdk" value="&lt;b&gt;App / Zalo SDK&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;data{sId, zagid, adId, vId, pkg/bId, sdkv, dId, aId, ser, mac, mod…}&lt;br&gt;device{aId,dId,ser,mod} · appId · viewer / oauthCode · sig&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="360" height="80" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;validateRequest&lt;/b&gt;&lt;br&gt;decrypt hoặc check &lt;code&gt;sig&lt;/code&gt; · parse DeviceData&lt;br&gt;sId (V2) → sid (V1) · dựng fingerprint ZDevice / HardDevice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="195" width="360" height="65" as="geometry"/></mxCell><mxCell id="egetid1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sdk" targ