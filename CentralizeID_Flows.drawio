p GID&lt;/b&gt;; GID/zdId lấy từ flow Get ID.&lt;br&gt;• uid ↔ thiết bị được đẩy ra qua &lt;b&gt;mapping_visitor&lt;/b&gt;; bên ngoài tự xây bảng nối.&lt;br&gt;• ⚠ viewer hiện làm hỏng việc lấy uid (xem docs 04 §12)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="620" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Sequence – Get Global ID" id="seqgid"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1890" pageHeight="1784" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seqgid_ll_sdk" value="&lt;b&gt;App / Zalo SDK&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="90" width="170" height="1654" as="geometry"/></mxCell><mxCell id="seqgid_ll_h" value="&lt;b&gt;centralizeid&lt;/b&gt;&lt;br&gt;DeviceIdHandler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="90" width="170" height="1654" as="geometry"/></mxCell><mxCell id="seqgid_ll_oa" value="&lt;b&gt;ZaloOAuth MW&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="90" width="170" height="1654" as="geometry"/></mxCell><mxCell id="seqgid_ll_st" value="&lt;b&gt;Storage + Cache&lt;/b&gt;&lt;br&gt;&lt;span style='font-