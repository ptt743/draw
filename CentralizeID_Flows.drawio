Arrow=block;endFill=1;fontSize=11;fontColor=#2d7600;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="db3" target="dc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="1355"/></Array></mxGeometry></mxCell><mxCell id="egetid29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.75;" edge="1" parent="1" source="riosv" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="1380"/><mxPoint x="580" y="1380"/></Array></mxGeometry></mxCell><mxCell id="egetid30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.75;" edge="1" parent="1" source="riosz" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="1380"/></Array></mxGeometry></mxCell><mxCell id="rc" value="&lt;b&gt;Dùng zagid&lt;/b&gt;&lt;br&gt;GET_ZAGID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="1325" width="160" height="60" as="geometry"/></mxCell><mxCell id="egetid31" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#2d7600;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dc" target="rc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dd" value="D. Vẫn chưa&lt;br&gt;có GID?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="1450" width="160" height="90" as="geometry"/></mxCell><mxCell id="egetid32" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dc" target="dd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rc" target="dd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="1430"/><mxPoint x="700" y="1430"/></Array></mxGeometry></mxCell><mxCell id="gen" value="&lt;b&gt;D. Sinh GID qua centralizeidmw&lt;/b&gt;&lt;br&gt;zenVisitor(platform, timestamp, 0, TClientSource+auth) – retry 3 lần&lt;br&gt;• lỗi fingerprint = -9 → timestamp = now (GEN_NEW_VISITOR)&lt;br&gt;• còn lại → timestamp = createdTime của sid (RECREATE_GID*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="870" y="1450" width="420" height="90" as="geometry"/></mxCell><mxCell id="egetid34" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#2d7600;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dd" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="err1" value="&lt;b&gt;-1&lt;/b&gt; Fail&lt;br&gt;(CANT_GET_GID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="1465" width="150" height="60" as="geometry"/></mxCell><mxCell id="egetid35" value="thất bại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gen" target="err1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="build" value="&lt;b&gt;E. Build zdid&lt;/b&gt; = V2(visitorId, createdTime, {pkg, pl})&lt;br&gt;&lt;span style='font-size:10px'&gt;mỗi package nhận 1 chuỗi zdid khác nhau&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="510" y="1590" width="380" height="60" as="geometry"/></mxCell><mxCell id="egetid36" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dd" target="build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid37" value="GID mới" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#2d7600;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.84;entryY=0;" edge="1" parent="1" source="gen" target="build"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1565"/><mxPoint x="830" y="1565"/></Array></mxGeometry></mxCell><mxCell id="resp" value="&lt;b&gt;Response&lt;/b&gt; {error:0, data:{deviceId: zdid, expiredTime: 43200000 (12h)}}&lt;br&gt;&lt;span style='font-size:10px'&gt;client cache zdid 12h, lần sau gửi lại làm sId&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="1700" width="420" height="60" as="geometry"/></mxCell><mxCell id="egetid38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="build" target="resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid39" value="zdid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="resp" target="sdk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="1730"/><mxPoint x="470" y="120"/></Array></mxGeometry></mxCell><mxCell id="as1" value="&lt;b&gt;ThreadPoolWorker – ghi mapping&lt;/b&gt; (bỏ qua nếu iOS &amp; adId == vId)&lt;br&gt;• fingerprint → GID: &lt;b&gt;chỉ khi GID là 3000.&lt;/b&gt; [mappingDeviceId_wr]&lt;br&gt;• adId → GID [adidToGid] ⚠ đang ghi adId&lt;br&gt;• gid.&amp;lt;gid&amp;gt; → devices [devicetogidv2] ⚠ key dùng adId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1820" width="420" height="90" as="geometry"/></mxCell><mxCell id="as2" value="&lt;b&gt;ZEventBus&lt;/b&gt;&lt;br&gt;• GID mới: zwp.globalid.gennewid&lt;br&gt;• GID có sẵn: zwp.globId_created (ACTIVE, isChangeGid)&lt;br&gt;• OpenAppNotifier → zwp.coop_appopen (CREATE_GLOBAL_ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1820" width="380" height="90" as="geometry"/></mxCell><mxCell id="as3" value="&lt;b&gt;Scribe&lt;/b&gt; (mọi request, kể cả lỗi)&lt;br&gt;• GLOBAL_ID_FOR_DEVICE (log cũ, có ActionGenGid)&lt;br&gt;• ZTP_GLOBAL_ID_FOR_DEVICE (JSON, sau khi trả response)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="1820" width="380" height="90" as="geometry"/></mxCell><mxCell id="egetid40" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;" edge="1" parent="1" source="build" target="as1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="1620"/></Array></mxGeometry></mxCell><mxCell id="egetid41" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="resp" target="as2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid42" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="resp" target="as3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="1730"/></Array></mxGeometry></mxCell><mxCell id="grpExt" value="Hệ thống ngoài" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#666666;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1390" y="120" width="300" height="900" as="geometry"/></mxCell><mxCell id="xst" value="&lt;b&gt;Storage + cache&lt;/b&gt;&lt;br&gt;ZiDB [mappingDeviceId]&lt;br&gt;StrListStr [devicetogidv2] [adidToGid]&lt;br&gt;StrList32 [DeviceUsersV2] (chỉ đọc)&lt;br&gt;JZiCache / MCZiCache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="600" width="260" height="140" as="geometry"/></mxCell><mxCell id="xoa" value="&lt;b&gt;ZaloOAuth MW&lt;/b&gt;&lt;br&gt;viewer / oauthCode → uid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="160" width="260" height="60" as="geometry"/></mxCell><mxCell id="xmw" value="&lt;b&gt;centralizeidmw&lt;/b&gt; (Thrift)&lt;br&gt;kiểm tra quyền TClientSource → IdZen.zenDeviceId()&lt;br&gt;→ buildVisitor → bắn zwp.globId_created (NEW)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="260" width="260" height="100" as="geometry"/></mxCell><mxCell id="xiz" value="&lt;b&gt;IdZen&lt;/b&gt;&lt;br&gt;sinh id tăng dần" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="400" width="140" height="50" as="geometry"/></mxCell><mxCell id="egetid43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="xmw" target="xiz"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid44" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="b1" target="xst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egetid45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;" edge="1" parent="1" source="ios1" target="xoa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="375"/><mxPoint x="1360" y="375"/><mxPoint x="1360" y="190"/></Array></mxGeometry></mxCell><mxCell id="egetid46" value="zenVisitor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;" edge="1" parent="1" source="gen" target="xmw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="1470"/><mxPoint x="1340" y="310"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;2 nguyên tắc chọn GID&lt;/b&gt;&lt;br&gt;1. Biết thiết bị thuộc user Zalo (DeviceUsersV2 / viewer / oauthCode / zagid 3000.) → luôn trả &lt;b&gt;3000.&amp;lt;uid&amp;gt;&lt;/b&gt;; B3 và C được phép ghi đè.&lt;br&gt;2. Không biết user → giữ GID thiết bị cũ (sid → fingerprint). Không tìm được mới sinh mới qua MW.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ quả:&lt;/b&gt; zdid cùng 1 máy có thể đổi 2002.xxx → 3000.xxx khi user đăng nhập.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chú thích màu&lt;/b&gt;: &lt;font color='#b8860b'&gt;■&lt;/font&gt; quyết định · &lt;font color='#9673a6'&gt;■&lt;/font&gt; GID được chọn (ActionGenGid) · &lt;font color='#b85450'&gt;■&lt;/font&gt; lỗi · nét đứt = bất đồng bộ / gọi hệ thống ngoài" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="1060" width="300" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Flow Tracking User (centralizeidtrackingapp)" id="track"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Flow Tracking User – &lt;font color='#6c8ebf'&gt;centralizeidtrackingapp&lt;/font&gt; (Jetty :4614)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="src" value="&lt;i&gt;Nguồn: origin/production (centralizeidtrackingapp 5d2de71) + docs/centralizeid/04&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="800" height="20" as="geometry"/></mxCell><mxCell id="pre" value="&lt;b&gt;Điều kiện trước (centralizeid)&lt;/b&gt;: SDK đã gọi &lt;code&gt;POST /id/mobile&lt;/code&gt; → nhận &lt;b&gt;zdid&lt;/b&gt; (gửi lên làm &lt;code&gt;zdId&lt;/code&gt;) và &lt;code&gt;POST /sdk/mobile&lt;/code&gt; → nhận &lt;b&gt;sdkId&lt;/b&gt; chứa privateKey (dùng mã hoá AES khi et&amp;gt;0 / explore)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1000" height="45" as="geometry"/></mxCell><mxCell id="sdk" value="&lt;b&gt;App / Zalo SDK&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Zalo, Báo Mới, Zing MP3, Laban…&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="280" height="60" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;① GET /apps/mobile/{pl}?appId&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="280" height="45" as="geometry"/></mxCell><mxCell id="a2" value="Lọc theo whitelist appId trong&lt;br&gt;[Configuration@trackingapps]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="280" height="55" as="geometry"/></mxCell><mxCell id="a3" value="Trả danh sách package cần quét + &lt;b&gt;scanId&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;SDK quét các app này rồi gửi kết quả qua ③ explore&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="280" height="55" as="geometry"/></mxCell><mxCell id="etrack1" value="1. lấy DS app cần quét" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sdk" target="a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="170"/></Array></mxGeometry></mxCell><mxCell id="etrack2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etrack3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="&lt;b&gt;③ POST /apps/mobile/explore/*&lt;/b&gt;&lt;br&gt;?sdkId&amp;amp;et (multipart part &lt;code&gt;zce&lt;/code&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="260" width="300" height="50" as="geometry"/></mxCell><mxCell id="c2" value="sdkId giải mã được? (-5)&lt;br&gt;multipart? (-6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="345" width="300" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Trả ngay &lt;b&gt;error 0&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1300" y="430" width="150" height="45" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Thread pool&lt;/b&gt;: giải mã AES (et=1) / JSON (et=0)&lt;br&gt;appId ∈ tracking-app · privateKey rỗng → bỏ âm thầm&lt;br&gt;oauthCode → uid; có uid + zdId là GID thiết bị → &lt;b&gt;mapping_visitor&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1180" y="560" width="380" height="75" as="geometry"/></mxCell><mxCell id="c5" value="Scribe &lt;b&gt;ZP_CENTRALIZED_TRACKING_EXPLORE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;13 cột: …, uid, zdId, scanId, apps&lt;/span&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="670" width="300" height="60" as="geometry"/></mxCell><mxCell id="etrack4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etrack5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etrack6" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etrack7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="&lt;b&gt;④ POST /pixel/{android,ios}&lt;/b&gt;&lt;br&gt;body JSON gzip · &lt;b&gt;không xác thực&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="260" width="280" height="50" as="geometry"/></mxCell><mxCell id="etrack8" value="4. pixel event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;" edge="1" parent="1" source="sdk" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="155"/></Array></mxGeometry></mxCell><mxCell id="d2" value="Validate: pl (-5), pkg (-29), pixel_id (-6),&lt;