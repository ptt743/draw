ource="diosu" target="riosz"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dparam" value="Có device&lt;br&gt;và pl?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="530" width="140" height="80" as="geometry"/></mxCell><mxCell id="egetid9" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dios" target="dparam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="err4" value="&lt;b&gt;-4&lt;/b&gt; Invalid param&lt;br&gt;(INVALID_PARAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="540" width="180" height="60" as="geometry"/></mxCell><mxCell id="egetid10" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dparam" target="err4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dsid" value="sid hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="650" width="140" height="80" as="geometry"/></mxCell><mxCell id="egetid11" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#2d7600;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dparam" target="dsid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="&lt;b&gt;B1. Dùng lại sid&lt;/b&gt;&lt;br&gt;getZdid(sid): sid đã map uid trong [DeviceUsersV2] → đổi sang 3000.&amp;lt;uid&amp;gt;&lt;br&gt;đọc danh sách thiết bị &lt;code&gt;gid.&amp;lt;gid&amp;gt;&lt;/code&gt; [devicetogidv2]" style="rounded=1;wh