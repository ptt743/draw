        <mxCell id="_afVUXXgETafG0vhBlnX-68" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeColor=#808080;strokeWidth=0.5;align=left;verticalAlign=top;fontSize=10;" value="How does Kafka ensure that messages of the corresponding type are written to the same partition?" vertex="1">
